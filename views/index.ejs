<%- include('partials/header') %>
        <h1>Create a custom link</h1>
        <p class="lead">Pick a name and the URL it should point to.</p>

        <form action="/save" method="post">
            <div class="field">
                <label for="url">Destination URL</label>
                <div class="input">
                    <input type="url" name="url" id="url" placeholder="https://example.com/some/long/path" required
                        autocorrect="off" autocapitalize="none" spellcheck="false" enterkeyhint="next">
                </div>
            </div>
            <div class="field">
                <label for="extension">Name</label>
                <div class="input">
                    <span class="prefix">/r/</span>
                    <input type="text" name="extension" id="extension" placeholder="my-link" pattern="[A-Za-z0-9_\-]+" required
                        aria-describedby="extension-hint" autocorrect="off" autocapitalize="none" spellcheck="false" enterkeyhint="done">
                </div>
                <p class="hint" id="extension-hint">Letters, numbers, "-" and "_".</p>
            </div>
            <button class="button" type="submit">Create link</button>
        </form>

        <script>
            const extension = document.getElementById('extension');
            extension.addEventListener('invalid', () => {
                if (extension.validity.patternMismatch) {
                    extension.setCustomValidity('Use only letters, numbers, "-" and "_" (no spaces).');
                }
            });
            extension.addEventListener('input', () => extension.setCustomValidity(''));
        </script>
<%- include('partials/footer') %>
